
# Function to print a message in the center of the terminal width-wise
print_centered_message() {
  local MESSAGE="$1"
  tput cup 0 $(( ($(tput cols) / 2) - (${#MESSAGE} / 2) ))
  echo "$MESSAGE"
}

# Function to open a new crome tab in the terminal
nd() {
    local BASE_URL=$1
    local CONTENT_TYPE=${2:-"Document"}
    local PATH="/#"

    if [[ -z "$BASE_URL" ]]; then
        echo "Usage: newDoc <base_url_or_keyword>"
        return 1
    fi

    if [[ "$BASE_URL" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(:[0-9]+)?$ || "$BASE_URL" == *"localhost"* ]]; then
        # If localhost, use port 3002
        if [[ "$BASE_URL" == "localhost" ]]; then
            BASE_URL="http://localhost:3002"
        elif [[ "$BASE_URL" =~ :[0-9]+$ ]]; then
        else
            # If IP without port, use the workspace path
            PATH="/workspace${PATH}/author"
        fi
    else
        # Otherwise, treat it as a keyword and append ".quark.com"
        BASE_URL="${BASE_URL}.quark.com"
        PATH="/workspace${PATH}/author"
    fi

    /opt/google/chrome/google-chrome --new-tab "${BASE_URL}${PATH}/edit?uri=qpp:%2F%2Fassets%2F-1&contentType=Smart%20${CONTENT_TYPE}"
}

# open new document on localhost:3002
ndlocal() {
    nd "localhost"
}

# open new document on dev
nddev() {
    nd "dev.app"
}

# Ignore Long commands
function zshaddhistory() {
  # If the command ($1) is longer than 200 characters, do not add it to history.
  (( ${#1} > 200 )) && return 1 || return 0
}

